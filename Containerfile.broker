# S-2 sandbox image (broker profile): the bounded, ephemeral environment in which
# the broker MCP servers' test suite runs. The brokers (src/gleipnir/broker/**)
# import the MCP SDK (FastMCP), which is NOT in the lean python self-host image
# (./Containerfile) by design — the enforcement core is stdlib-only and its test
# image stays minimal. This separate image isolates the mcp trusted surface to
# broker testing only, so the default python profile's blast radius is unchanged.
#
# Mirrors ./Containerfile's shape (pinned base, dev tooling preinstalled, no
# ENTRYPOINT, no source/creds baked in, --network=none-runnable at test time).
#
# mcp is bounded to 1.x: `mcp>=1.0,<2`. mcp 2.0 REMOVED mcp.server.fastmcp
# (FastMCP split out), which the brokers use — an open-ended `>=1.0.0` would
# resolve to a FastMCP-less 2.x. See .gleipnir/decisions/runtime-and-deps.md.

# python:3.12-slim, same digest-pinned base as the python profile (./Containerfile).
FROM docker.io/library/python:3.12-slim@sha256:55842c72c6b3584d06ec84c731fc516b30b8a53ad262ebd085e47ab568b3bfc1

# Dev test tooling + the broker-layer runtime dep (bounded to the FastMCP-bearing
# 1.x line). Pre-installed so test runs need NO network (--network=none holds).
RUN pip install --no-cache-dir "pytest>=8,<9" "pytest-cov>=5,<6" "mcp>=1.0,<2"

# Default workdir matches the run-argv's -w /work (the ro source bind mount).
WORKDIR /work

# No ENTRYPOINT/CMD: the entrypoint argv is supplied per-run by
# src/gleipnir/sandbox/runtime.py's build_run_argv.
