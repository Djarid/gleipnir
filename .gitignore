.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.gleipnir/.tmp/

# Tier-0 scratch: keep the README, ignore everything else
.gleipnir/var/tmp/*
!.gleipnir/var/tmp/README.md

# keys/: policy + digest manifests are versioned; real key material never is
.gleipnir/keys/*.key
.gleipnir/keys/*.secret

# coverage data + sandbox runtime scratch
.coverage
.coverage.*
.gleipnir/var/run/
