.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
.gleipnir/.tmp/

# Tier-0 scratch: keep the README, ignore everything else
.gleipnir/var/tmp/*
!.gleipnir/var/tmp/README.md

# keys/: policy + digest manifests are versioned; real key material never is
.gleipnir/keys/*.key
.gleipnir/keys/*.secret

# host-local S-2 caged-mode drop-target identity (per-machine uid/gid; never committed)
.gleipnir/agent-identity.env

# direnv env file: carries host-local secrets (e.g. GITHUB_TOKEN); never committed.
# Was previously tracked (scaffold commit 8cad21d); untracked via `git rm --cached .envrc`.
.envrc

# coverage data + sandbox runtime scratch
.coverage
.coverage.*
.gleipnir/var/run/
