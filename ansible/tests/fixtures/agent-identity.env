# ansible/tests/fixtures/agent-identity.env
#
# DISPOSABLE test fixture — NOT the real .gleipnir/agent-identity.env.
# Deliberately uses uid/gid 9999 (never 510) so a test run can never be
# confused with the real agent identity, and so grepping the real repo for
# the literal "510" (AC-nolit) never turns up anything from this fixture.
GLEIPNIR_AGENT_UID=9999
GLEIPNIR_AGENT_GID=9999
