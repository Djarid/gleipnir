#!/bin/sh
# Gleipnir Tier-3 out-of-band approval listener -- operator start shim.
#
# MANUAL FALLBACK (Decision 15, superseded by
# `.gleipnir/plans/tier3-mcp-approval-launcher.md`): run by the OPERATOR,
# manually, when they want to start the listener outside an opencode session
# (e.g. debugging, CI, or a headless run). The PRIMARY supervised launch path
# is now the `gleipnir-approval` local MCP (`python -m
# gleipnir.approval.mcp_server`), spawned by opencode per `opencode.jsonc`'s
# `mcp."gleipnir-approval"` block -- NOT YET APPLIED as of this delegation
# (Tier-3, operator/build-mode territory). Both launch paths exec the SAME
# `run_server` entrypoint below, so this shim costs nothing to keep and
# remains genuinely useful when opencode is not the launcher.
# A long-running, cooperative process: the operator starts it and Ctrl-C
# stops it. Deliberately a THIN shim (same shape as bin/gleipnir-preflight
# and bin/gleipnir-sandbox): it does nothing but exec the stdlib-Python
# listener in src/gleipnir/approval/server.py. All decision logic (identity
# resolution, token minting, the HTTP surface) lives there and is
# unit-tested.
#
# SECURITY RATIONALE (corrected): the property this shim -- and the MCP
# launch path -- protects was never "who launches the process" but that the
# HMAC signing key stays unreachable to the agent tool surface (Decision 3):
# launching confers process-supervision only, never the ability to mint a
# token. See `src/gleipnir/approval/mcp_server.py`'s module docstring for
# the fuller rationale; not duplicated here.
#
# Binds 127.0.0.1 only (no public surface); the operator fronts it with
# `tailscale serve` (an operator OS act, not built by this shim) for
# tailnet-only reachability.
#
# Resolve the repo root from this script's own location so it works
# regardless of the caller's cwd.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/.." && pwd)
PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$repo/.venv/bin/python" -m gleipnir.approval.server "$@"
