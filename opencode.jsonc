{
  // Gleipnir project config.
  //
  // The Gleipnir framework keeps its own config surface in `.gleipnir/`
  // (agents, skills, commands, plugins), kept distinct from any target
  // project's `.opencode/`. opencode is pointed at that directory with the
  // OPENCODE_CONFIG_DIR environment variable, which makes opencode search
  // `.gleipnir/` for `agents/`, `skills/`, `commands/` and `plugins/` exactly
  // as it would the standard `.opencode/` directory.
  //
  // Launch Gleipnir with:
  //
  //     OPENCODE_CONFIG_DIR=.gleipnir opencode
  //
  // A `.envrc` in the repo root sets this automatically if you use direnv
  //   (https://direnv.net) — run `direnv allow` once. If direnv is not
  //   installed, either install it (brew install direnv) or set the var in
  //   your shell rc / prefix each launch as above. The separation also sets up
  //   the future G-1 story: guard config lives at one known path the S-2
  //   substrate boundary can make agent-unreachable.
  //
  // Status: authored, not yet closed. This is the step-0 scaffold. The
  // substrate boundary, broker, event bus and deterministic G-5 engine do not
  // exist yet; see `.gleipnir/AGENTS.md` for the guard-status table.

  "$schema": "https://opencode.ai/config.json",

  // --------------------------------------------------------------------------
  // Orchestrator context-length cap: UNSET (operator decision).
  //
  // The cap is intentionally in its "unset = no cap = model default" state
  // (.gleipnir/policy/context-cap.jsonc). The orchestrator runs plain
  // aperture-anthropic/anthropic.claude-sonnet-5 with NO capped alias and NO
  // limit.context override, so Sonnet 5's own default context window applies.
  //
  // No capped-alias "provider" block is present here BY DESIGN: absence of the
  // override IS the documented unset state (never limit.context: 0 to mean
  // "unset"). To re-apply a cap later, re-add a capped alias under
  // aperture-anthropic with limit { context: <cap>, output: <base output> } and
  // repoint orchestrator.md `model:` at it (see .gleipnir/decisions/context-cap.md).
  // --------------------------------------------------------------------------

  // The orchestrator is the primary entry point: the G-5-engine stand-in that
  // drives the pipeline and delegates every unit of work to a bounded subagent.
  "default_agent": "orchestrator",

  // Allow one level of nested delegation so the orchestrator's stage
  // subagents can themselves delegate where the pipeline requires it.
  "subagent_depth": 1,

  // --------------------------------------------------------------------------
  // Broker MCP servers (spec T-2 / G-2 single-holder, E-1 argument policy).
  //
  // Two pointy, purpose-scoped stdio MCP servers. Each is an independently
  // versioned broker component (src/gleipnir/broker/{git,pm}/, own pyproject +
  // VERSION + bounded mcp>=1.0,<2 range). They import the MCP SDK (FastMCP),
  // which lives in the host .venv; the enforcement core stays stdlib-only. See
  // .gleipnir/decisions/{runtime-and-deps.md, broker-mcp.md}.
  //
  // Launched as stdio subprocesses. PYTHONPATH=src so `gleipnir.broker.*`
  // resolves the same way the sandbox/tests do. `mcp` resolves from .venv.
  //
  // Single-holder scoping is done per-agent by DENY-LIST (AETOS-proven pattern):
  // the MCP tools are enabled globally here, and each agent frontmatter DENIES
  // the broker namespace(s) it must not hold. git-ops keeps gleipnir-git_* and
  // denies gleipnir-pm_*; project-mgr keeps gleipnir-pm_* and denies
  // gleipnir-git_*; every OTHER roster agent denies BOTH. (A global-disable +
  // per-agent re-allow does NOT surface MCP tools to a subagent — see lesson
  // L-C12b; deny-list is the working form. Tool names are `<server>_<tool>`, so
  // the namespace glob is `gleipnir-git_*` / `gleipnir-pm_*`.)
  // --------------------------------------------------------------------------
  "mcp": {
    "gleipnir-git": {
      "type": "local",
      "command": [".venv/bin/python", "-m", "gleipnir.broker.git.mcp_server"],
      "environment": {
        "PYTHONPATH": "src"
      },
      "enabled": true
    },
    "gleipnir-pm": {
      "type": "local",
      "command": [".venv/bin/python", "-m", "gleipnir.broker.pm.mcp_server"],
      "environment": {
        "PYTHONPATH": "src",
        "GITLAB_TOKEN": "{env:GITLAB_TOKEN}",
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  },

  // Framework instruction context loaded into every session.
  "instructions": [
    ".gleipnir/AGENTS.md",
    ".gleipnir/stage-role-map.md"
  ]
}
