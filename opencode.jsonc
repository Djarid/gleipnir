{
  // Gleipnir project config.
  //
  // The Gleipnir framework keeps its own config surface in `.gleipnir/`
  // (agents, skills, commands, plugins), kept distinct from any target
  // project's `.opencode/`. opencode is pointed at that directory with the
  // OPENCODE_CONFIG_DIR environment variable, which makes opencode search
  // `.gleipnir/` for `agents/`, `skills/`, `commands/` and `plugins/` exactly
  // as it would the standard `.opencode/` directory.
  //
  // Launch Gleipnir with:
  //
  //     OPENCODE_CONFIG_DIR=.gleipnir opencode
  //
  // A `.envrc` in the repo root sets this automatically if you use direnv
  //   (https://direnv.net) — run `direnv allow` once. If direnv is not
  //   installed, either install it (brew install direnv) or set the var in
  //   your shell rc / prefix each launch as above. The separation also sets up
  //   the future G-1 story: guard config lives at one known path the S-2
  //   substrate boundary can make agent-unreachable.
  //
  // Status: authored, not yet closed. This is the step-0 scaffold. The
  // substrate boundary, broker, event bus and deterministic G-5 engine do not
  // exist yet; see `.gleipnir/AGENTS.md` for the guard-status table.

  "$schema": "https://opencode.ai/config.json",

  // --------------------------------------------------------------------------
  // Orchestrator context-length cap (Tier-3 ENFORCEMENT MIRROR).
  //
  // SINGLE SOURCE OF TRUTH: .gleipnir/policy/context-cap.jsonc (cap_tokens).
  // Keep the limit.context below numerically EQUAL to that file's cap_tokens.
  //
  // Mechanism: this declares a DISTINCT capped model id under the (globally
  // defined) aperture-anthropic provider — same underlying model as
  // anthropic.claude-opus-4-8, differing ONLY by limit.context. ONLY the
  // orchestrator points its `model:` at this capped id
  // (.gleipnir/agents/orchestrator.md); every other opus agent keeps the
  // uncapped anthropic.claude-opus-4-8, so the cap does not leak to
  // gleipnir-plan / gleipnir-brainstorm (scope = orchestrator only).
  //
  // UNSET = NO CAP = MODEL DEFAULT: to remove the artificial constraint, delete
  // this whole "provider" block AND repoint orchestrator.md `model:` back to
  // aperture-anthropic/anthropic.claude-opus-4-8. Absence of the override = the
  // model's default limit (never write limit.context: 0 to mean "unset").
  //
  // RESTART-TIME VERIFICATION (spike residual, interactive-session-context-cap-spike.md):
  // this alias id must resolve to a real served model at the aperture endpoint.
  // Verify on next opencode start that the orchestrator loads and reports a
  // 250000 context window while a subagent (e.g. gleipnir-code) reports its
  // base window. If the endpoint rejects the alias key as an unknown model,
  // escalate to the reserved Approach-B scoped plugin (do NOT silently adopt).
  // --------------------------------------------------------------------------
  "provider": {
    "aperture-anthropic": {
      "models": {
        // Capped alias of claude-opus-4-8 for the orchestrator only.
        "anthropic.claude-opus-4-8-capped": {
          "name": "claude-opus-4-8 (capped 250K, orchestrator)",
          "tool_call": true,
          "limit": {
            "context": 250000,
            // Schema requires both keys. `output` is NOT a functional cap we
            // care about here (intent is the context cap); it must simply be
            // present and MATCH the base model so the alias differs from
            // anthropic.claude-opus-4-8 only by limit.context. 32000 is the
            // Opus output cap at this Bedrock/Mantle endpoint (per
            // ../aetos/opencode.json:12, which declares Opus as
            // limit.context 200000 / output 32000).
            "output": 32000
          }
        }
      }
    }
  },

  // The orchestrator is the primary entry point: the G-5-engine stand-in that
  // drives the pipeline and delegates every unit of work to a bounded subagent.
  "default_agent": "orchestrator",

  // Allow one level of nested delegation so the orchestrator's stage
  // subagents can themselves delegate where the pipeline requires it.
  "subagent_depth": 1,

  // Framework instruction context loaded into every session.
  "instructions": [
    ".gleipnir/AGENTS.md",
    ".gleipnir/stage-role-map.md"
  ]
}
