# Gleipnir — direnv environment for this repo.
#
# Points opencode at the Gleipnir framework config directory (.gleipnir/)
# instead of the default .opencode/, so every opencode session in this repo
# uses the Gleipnir roster, skills and stage-to-role map.
#
# Requires direnv (https://direnv.net). After editing, run: direnv allow
export OPENCODE_CONFIG_DIR=.gleipnir
